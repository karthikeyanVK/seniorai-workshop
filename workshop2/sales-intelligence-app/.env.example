# Copy to .env and fill in. Never commit .env. Server-only: no variable here is exposed to the browser.

# Azure OpenAI (leave API_KEY empty to use Managed Identity / az login)
API_BASE=https://<your-openai-resource>.openai.azure.com/
API_KEY=<optional-api-key>
API_VERSION=2025-01-01-preview
DEPLOYMENT_NAME=gpt-4o-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Cosmos DB knowledge base, built by sales-intelligence-jobs.
COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_KEY=<account-key>
COSMOS_DATABASE=SALES-KB
COSMOS_CONTAINER=sales-kb-chunks

# Sales SQL database (ADO.NET-style SQL Server connection string)
SQL_DB_SALESINTELLIGENCE=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<db>;User ID=<user>;Password=<password>;Encrypt=True;
# Recommended: a login with db_datareader only. When set, it is used instead of SQL_DB_SALESINTELLIGENCE.
SQL_DB_SALESINTELLIGENCE_READONLY=

# Optional tuning (defaults shown)
# Comma-separated dbo tables the agent may query; default = all 11 sales tables
SQL_ALLOWED_TABLES=
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=15000
AGENT_MAX_STEPS=6
AGENT_HISTORY_MESSAGES=20
LOG_LEVEL=info

# Optional Azure Cosmos DB semantic reranker (preview). Unset = rerank off, search behaves as before.
# Queries keep using COSMOS_ENDPOINT + COSMOS_KEY; only the rerank call needs AAD (az login / managed identity).
# Format: https://<cosmos-account>.<region>.dbinference.azure.com
COSMOS_INFERENCE_ENDPOINT=
