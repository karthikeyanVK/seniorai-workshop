# Azure OpenAI Configuration
DEPLOYMENT_NAME=gpt-4o-mini
API_BASE=https://claude-code-demo-1.openai.azure.com/
API_KEY=
API_TYPE=azure
API_VERSION=2025-01-01-preview
AUDIENCE_NAME=

# RAG knowledge base (Cosmos DB, built by VoterChatBotJobs)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=SALES-KB
EMBEDDING_DEPLOYMENT=text-embedding-3-small


# Azure Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=
SQL_DB_SALESINTELLIGENCE=


# --- Ingestion pipeline (added by sales-intelligence-jobs setup; existing values above untouched) ---
# Cosmos DB container for chunks + vectors (created automatically when COSMOS_AUTO_CREATE=true)
COSMOS_CONTAINER=sales-kb-chunks
COSMOS_AUTO_CREATE=true
# Must match the embedding model: text-embedding-3-small=1536, text-embedding-3-large=3072
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16

# Blob source for knowledge-base Markdown (uses AZURE_STORAGE_CONNECTION_STRING above)
KB_BLOB_CONTAINER=knowledge-base
KB_BLOB_PREFIX=
# Managed Identity alternative to the connection string, e.g. https://<account>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=
# Client ID of a user-assigned Managed Identity (leave empty for system-assigned / az login)
AZURE_CLIENT_ID=

# Schedule (NCRONTAB: sec min hour day month weekday) and tuning
INGEST_SCHEDULE=0 0 */6 * * *
INGEST_CONCURRENCY=4
MAX_RETRIES=5
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=80
CHUNK_HARD_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=64
LOG_LEVEL=info
COSMOS_INFERENCE_ENDPOINT=
# Cosmos connection string (fill in; includes the account key)
COSMOS_INFERENCE_KEY=

