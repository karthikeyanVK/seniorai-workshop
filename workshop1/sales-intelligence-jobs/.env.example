# Copy to .env and fill in. Never commit .env.

# Audience version (required, lowercase, alphanumeric/hyphen, max 12 chars).
# COSMOS_DATABASE, COSMOS_CONTAINER and KB_BLOB_CONTAINER below become <base>-<AUDIENCE_NAME>.
AUDIENCE_NAME=karthik

# Azure OpenAI (leave API_KEY empty to use Managed Identity / az login)
API_BASE=https://<aoai-resource>.openai.azure.com/
API_KEY=
API_VERSION=2025-01-01-preview
EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Must match the model: text-embedding-3-small=1536, text-embedding-3-large=3072
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16

# Cosmos DB for NoSQL. Connection string OR endpoint (+ key, or empty for Managed Identity)
COSMOS_CONNECTION_STRING=
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=SALES-KB-karthik
COSMOS_CONTAINER=sales-kb-chunks-karthik
# false for Managed Identity (pre-create the container)
COSMOS_AUTO_CREATE=true
# quantizedFlat (default, small corpora) or diskANN
COSMOS_VECTOR_INDEX=quantizedFlat

# Blob source. Connection string OR account URL (Managed Identity)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
KB_BLOB_CONTAINER=knowledge-base-karthik
KB_BLOB_PREFIX=
# Client ID of a user-assigned Managed Identity (empty = system-assigned / az login)
AZURE_CLIENT_ID=

# Schedule (NCRONTAB: sec min hour day month weekday) and tuning
INGEST_SCHEDULE=0 0 */6 * * *
INGEST_CONCURRENCY=4
MAX_RETRIES=5
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=80
CHUNK_HARD_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=64
LOG_LEVEL=info
